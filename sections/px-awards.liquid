{%- comment -%}
  Award seals CONNETIX has received, shown at a modest, even height.
{%- endcomment -%}
<section class="px-awards" aria-labelledby="PxAwardsTitle-{{ section.id }}">
  <div class="px-awards__inner">
    <div class="px-head px-awards__head">
      <h2 class="px-head__title" id="PxAwardsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="px-head__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
    <ul class="px-awards__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          <li class="px-awards__item" {{ block.shopify_attributes }}>
            {{
              block.settings.image
              | image_url: width: 300
              | image_tag:
                loading: 'lazy',
                widths: '150, 300',
                sizes: '120px',
                alt: block.settings.alt,
                class: 'px-awards__seal'
            }}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .px-awards {
    padding-block: clamp(40px, 6vw, 80px);
    padding-inline: var(--page-margin, 16px);
    background: var(--px-paper);
    color: var(--px-ink);
  }

  .px-awards__inner {
    max-inline-size: var(--page-content-width, 1280px);
    margin-inline: auto;
  }

  .px-awards__head {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  .px-awards__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(16px, 3vw, 40px) clamp(20px, 3.5vw, 48px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .px-awards__seal {
    display: block;
    inline-size: auto;
    block-size: clamp(64px, 8vw, 96px);
    max-inline-size: 120px;
    object-fit: contain;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Awards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Award-winning play"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "award",
      "name": "Award",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Seal"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Award name",
          "info": "Read by screen readers, e.g. \"Mother & Baby Awards 2026, Gold, Best Toddler Toy\"."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Awards"
    }
  ]
}
{% endschema %}
