{%- comment -%}
  Short vertical CONNETIX play videos in a row on a navy band.
  Each plays only while on screen and can be paused.
{%- endcomment -%}
<section class="px-reel" aria-labelledby="PxReelTitle-{{ section.id }}">
  <div class="px-reel__inner">
    <div class="px-head">
      <h2 class="px-head__title" id="PxReelTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="px-head__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
    <ul class="px-reel__list" role="list">
      {%- for block in section.blocks -%}
        <li class="px-reel__item" {{ block.shopify_attributes }}>
          <figure class="px-reel__figure">
            {%- render 'px-video',
              video: block.settings.video,
              url: block.settings.video_url,
              poster: block.settings.poster,
              ratio: '9 / 16',
              class: 'px-reel__video',
              label: block.settings.caption
            -%}
            {%- if block.settings.caption != blank -%}
              <figcaption class="px-reel__caption">
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.caption | escape }}</a>
                {%- else -%}
                  {{ block.settings.caption | escape }}
                {%- endif -%}
              </figcaption>
            {%- endif -%}
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .px-reel {
    padding-block: clamp(48px, 7vw, 96px);
    padding-inline: var(--page-margin, 16px);
    background: var(--px-ink);
    color: var(--px-white);
  }

  .px-reel__inner {
    max-inline-size: var(--page-content-width, 1280px);
    margin-inline: auto;
  }

  .px-reel__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(64vw, 280px);
    gap: 12px;
    margin: 0;
    margin-inline: calc(-1 * var(--page-margin, 16px));
    padding: 0 var(--page-margin, 16px) 8px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-margin, 16px);
    scrollbar-width: thin;
  }

  @media screen and (min-width: 990px) {
    .px-reel__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--reel-cols, 3), minmax(0, 1fr));
      gap: 20px;
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }
  }

  .px-reel__item {
    scroll-snap-align: start;
  }

  .px-reel__figure {
    margin: 0;
  }

  .px-reel__video {
    border-radius: var(--px-radius-panel, 24px);
    background: #26355e;
  }

  .px-reel__caption {
    margin-block-start: 12px;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .px-reel__caption a {
    color: inherit;
    text-underline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Video reel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See it in motion"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Video",
      "limit": 4,
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL (MP4)",
          "info": "Used when no video is selected above."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Caption link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video reel"
    }
  ]
}
{% endschema %}
