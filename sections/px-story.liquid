{%- comment -%}
  Brand story: a photograph with a short passage from CONNETIX's own story.
{%- endcomment -%}
<section class="px-story" aria-labelledby="PxStoryTitle-{{ section.id }}">
  <div class="px-story__inner">
    {%- if section.settings.image != blank -%}
      <div class="px-story__media">
        {{
          section.settings.image
          | image_url: width: 1000
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000',
            sizes: '(min-width: 990px) 45vw, 100vw',
            alt: section.settings.alt,
            class: 'px-story__img'
        }}
      </div>
    {%- endif -%}
    <div class="px-story__copy">
      <h2 class="px-head__title" id="PxStoryTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <div class="px-story__text">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="px-btn px-btn--quiet" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .px-story {
    padding-block: clamp(48px, 7vw, 96px);
    padding-inline: var(--page-margin, 16px);
    background: var(--px-mist);
    color: var(--px-ink);
  }

  .px-story__inner {
    display: grid;
    gap: clamp(24px, 5vw, 72px);
    align-items: center;
    max-inline-size: var(--page-content-width, 1280px);
    margin-inline: auto;
  }

  @media screen and (min-width: 990px) {
    .px-story__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .px-story__img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--px-radius-panel, 24px);
  }

  .px-story__copy {
    display: grid;
    gap: var(--px-space-5, 24px);
    justify-items: start;
    max-inline-size: 58ch;
  }

  .px-story__text {
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .px-story__text p {
    margin: 0 0 1em;
  }

  .px-story__text p:last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Photo description"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made by educators and parents"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Brand story"
    }
  ]
}
{% endschema %}
