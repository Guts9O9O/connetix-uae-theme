{%- comment -%}
  Homepage hero. Copy on the left; on the right, four CONNETIX range photographs set as
  tiles that snap together on load, like magnetic tiles meeting at an edge, then flash
  once along their seams ("click"). On a mouse or trackpad the tiles lean a few pixels
  toward the pointer (px-motion.js). This is the page's one orchestrated motion moment.
  Photos never fade, so the first one paints at once (LCP). Reduced motion: no movement.
{%- endcomment -%}
{%- liquid
  assign facts = section.settings.facts
  if facts contains '[price]'
    assign from_price = ''
    assign fc = section.settings.facts_collection
    if fc == blank
      assign fc = collections['starter-sets']
    endif
    assign min_cents = 0
    for p in fc.products limit: 50
      if p.available
        if min_cents == 0 or p.price < min_cents
          assign min_cents = p.price
        endif
      endif
    endfor
    if min_cents > 0
      assign from_price = min_cents | money_without_trailing_zeros
    endif
    if from_price == ''
      assign facts = section.settings.facts_fallback
    else
      assign facts = facts | replace: '[price]', from_price
    endif
  endif
-%}
<section class="px-hero" aria-labelledby="PxHeroTitle-{{ section.id }}">
  <div class="px-hero__inner">
    <div class="px-hero__copy">
      <h1 class="px-hero__title" id="PxHeroTitle-{{ section.id }}" style="--i: 0;">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="px-hero__text" style="--i: 1;">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="px-hero__actions" style="--i: 2;">
        {%- if section.settings.button_1_label != blank -%}
          <a class="px-btn px-btn--primary" href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_1_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="px-btn px-btn--quiet" href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_2_label | escape -}}
          </a>
        {%- endif -%}
      </div>
      {%- if facts != blank -%}
        <p class="px-hero__facts" style="--i: 3;">{{ facts | escape }}</p>
      {%- endif -%}
    </div>

<ul class="px-hero__tiles" role="list" data-px-snap-in data-px-lean>
      {%- for block in section.blocks limit: 4 -%}
        {%- liquid
          assign img = block.settings.image
          assign url = block.settings.link | default: routes.all_products_collection_url
          if forloop.first
            assign loading = 'eager'
            assign priority = 'high'
          else
            assign loading = 'eager'
            assign priority = 'auto'
          endif
        -%}
        <li
          class="px-hero__tile"
          style="--room: {{ block.settings.room }}; --i: {{ forloop.index0 }};"
          {{ block.shopify_attributes }}
        >
          <a class="px-hero__tile-link" href="{{ url }}">
            {%- if img != blank -%}
              {{
                img
                | image_url: width: 1000
                | image_tag:
                  loading: loading,
                  fetchpriority: priority,
                  widths: '360, 500, 700, 1000',
                  sizes: '(min-width: 990px) 26vw, 48vw',
                  alt: block.settings.alt,
                  class: 'px-hero__img',
                  style: block.settings.focal
              }}
            {%- endif -%}
            <span class="px-hero__label">{{ block.settings.label | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .px-hero {
    padding-inline: var(--page-margin, 16px);
    padding-block: clamp(20px, 3.5vw, 48px) clamp(40px, 6vw, 88px);
    background: var(--px-paper);
    color: var(--px-ink);
  }

  .px-hero__inner {
    display: grid;
    gap: clamp(28px, 4vw, 72px);
    align-items: center;
    max-inline-size: var(--page-content-width, 1280px);
    margin-inline: auto;
  }

  .px-hero__copy {
    min-inline-size: 0;
  }

  @media screen and (min-width: 990px) {
    .px-hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }

    /* Keep the whole hero, buttons included, inside a laptop screen */
    .px-hero__tiles {
      inline-size: min(100%, calc((100svh - 200px) * 1.2));
      justify-self: end;
    }

    .px-hero__tiles .px-hero__tile {
      aspect-ratio: 6 / 5;
    }
  }

  .px-hero__title {
    margin: 0;
    max-inline-size: 12ch;
    font-family: var(--font-heading--family);
    font-size: clamp(2.625rem, 4.4vw + 1rem, 5.25rem);
    font-weight: var(--font-heading--weight, 700);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--px-ink);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .px-hero__text {
    max-inline-size: 40ch;
    margin-block-start: var(--px-space-5, 24px);
    font-size: clamp(1.0625rem, 0.4vw + 0.95rem, 1.25rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .px-hero__text p {
    margin: 0;
  }

  .px-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--px-space-3, 12px);
    margin-block-start: var(--px-space-6, 32px);
  }

  .px-hero__facts {
    margin: var(--px-space-5, 24px) 0 0;
    max-inline-size: 44ch;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--px-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .px-hero__tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(8px, 1vw, 12px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .px-hero__tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: clamp(16px, 2vw, 28px);
    overflow: hidden;
    background: var(--room, var(--px-mist));
    box-shadow: var(--px-bevel);
    transition: translate 420ms var(--px-ease-out);
  }

  /* The "click": a light line runs round each tile once they meet */
  .px-hero__tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.9);
    opacity: 0;
    pointer-events: none;
  }

  .px-hero__tile-link {
    display: block;
    block-size: 100%;
    color: var(--px-ink);
    text-decoration: none;
  }

  .px-hero__img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: scale var(--px-d-l, 560ms) var(--px-ease-out);
  }

  .px-hero__label {
    position: absolute;
    inset-block-end: clamp(10px, 1.4vw, 16px);
    inset-inline-start: clamp(10px, 1.4vw, 16px);
    padding: 6px 14px;
    border-radius: var(--px-radius-pill, 999px);
    background: var(--px-white);
    font-size: clamp(0.8125rem, 1vw, 0.9375rem);
    font-weight: 600;
    line-height: 1.2;
    box-shadow: var(--px-shadow-1);
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .px-hero__tile-link:hover .px-hero__img {
      scale: 1.04;
    }
  }

  .px-hero__tile-link:focus-visible {
    outline: var(--focus-outline-width, 3px) solid var(--px-ink);
    outline-offset: -6px;
    border-radius: inherit;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Copy: the heading rises (no fade, so it paints at once); the rest follow */
    .px-hero__copy > * {
      animation: px-hero-rise 600ms var(--px-ease-enter) both;
      animation-delay: calc(var(--i, 0) * 110ms);
    }

    .px-hero__copy > :not(.px-hero__title) {
      animation-name: px-hero-rise-in;
    }

    /* Tiles: each starts a little apart and tilted, then meets the others with one overshoot */
    [data-px-snap-in] .px-hero__tile {
      animation: px-hero-snap 560ms var(--px-ease-snap) both;
      animation-delay: calc(80ms + var(--i) * 60ms);
    }

    [data-px-snap-in] .px-hero__tile::after {
      animation: px-hero-click 380ms var(--px-ease-out) both;
      animation-delay: calc(560ms + var(--i) * 60ms);
    }

    [data-px-snap-in] .px-hero__tile:nth-child(1) { --from-x: -28px; --from-y: -24px; --from-r: -4deg; }
    [data-px-snap-in] .px-hero__tile:nth-child(2) { --from-x: 28px; --from-y: -24px; --from-r: 4deg; }
    [data-px-snap-in] .px-hero__tile:nth-child(3) { --from-x: -28px; --from-y: 24px; --from-r: 3deg; }
    [data-px-snap-in] .px-hero__tile:nth-child(4) { --from-x: 28px; --from-y: 24px; --from-r: -3deg; }
  }

  /* Transform only (no fade), so the first photo paints at once and stays the LCP element */
  @keyframes px-hero-snap {
    from {
      transform: translate(var(--from-x, 0), var(--from-y, 0)) rotate(var(--from-r, 0deg)) scale(0.94);
    }
    to {
      transform: none;
    }
  }

  @keyframes px-hero-click {
    0% { opacity: 0; }
    35% { opacity: 1; }
    100% { opacity: 0; }
  }

  @keyframes px-hero-rise {
    from { transform: translateY(14px); }
    to { transform: none; }
  }

  @keyframes px-hero-rise-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero: range tiles",
  "class": "px-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Magnetic tiles that grow with your child"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "First button label",
      "default": "Shop all sets"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label",
      "default": "Find a pack"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link"
    },
    {
      "type": "text",
      "id": "facts",
      "label": "Facts line",
      "info": "[price] is replaced by the lowest price in the collection below.",
      "default": "Starter packs from [price]. Safety tested for ages 3 and up."
    },
    {
      "type": "collection",
      "id": "facts_collection",
      "label": "Collection for [price]"
    },
    {
      "type": "text",
      "id": "facts_fallback",
      "label": "Facts line without a price",
      "default": "Safety tested for ages 3 and up. Every range connects."
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Photo tile",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Photo description",
          "info": "Describe the photo for people using screen readers."
        },
        {
          "type": "select",
          "id": "focal",
          "label": "Crop focus",
          "options": [
            { "value": "object-position: 50% 50%;", "label": "Centre" },
            { "value": "object-position: 50% 100%;", "label": "Bottom" },
            { "value": "object-position: 38% 50%;", "label": "Left of centre" },
            { "value": "object-position: 62% 50%;", "label": "Right of centre" }
          ],
          "default": "object-position: 50% 50%;"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "room",
          "label": "Backdrop colour",
          "info": "Match the photo's background so the photo has no visible edge.",
          "default": "#bdb8da"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero: range tiles"
    }
  ]
}
{% endschema %}
