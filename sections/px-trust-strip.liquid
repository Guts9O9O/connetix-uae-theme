{%- comment -%}
  Trust strip: short, verifiable reassurance points. Only add a delivery, returns or
  warranty promise once the business has confirmed it.
{%- endcomment -%}
<section class="px-trust" aria-label="{{ section.settings.label | escape }}">
  <ul class="px-trust__list" role="list">
    {%- for block in section.blocks -%}
      <li class="px-trust__item" {{ block.shopify_attributes }}>
        <span class="px-trust__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'currency' -%}
              <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="2.6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
            {%- when 'lock' -%}
              <svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 10V7.5a4 4 0 0 1 8 0V10" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
            {%- when 'language' -%}
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3.5 12h17M12 3.5c2.5 2.6 2.5 14.4 0 17M12 3.5c-2.5 2.6-2.5 14.4 0 17" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
            {%- when 'shield' -%}
              <svg viewBox="0 0 24 24"><path d="M12 3 19 6v5.5c0 4.2-3 7.7-7 9.5-4-1.8-7-5.3-7-9.5V6Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8.8 12 2.2 2.2 4.2-4.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24"><rect x="2.5" y="7" width="9.5" height="10" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="12" y="7" width="9.5" height="10" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
          {%- endcase -%}
        </span>
        <span class="px-trust__text">
          <strong>{{ block.settings.title | escape }}</strong>
          {%- if block.settings.text != blank -%}
            <span>{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </span>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% stylesheet %}
  .px-trust {
    padding-block: var(--px-space-6, 32px);
    padding-inline: var(--page-margin, 16px);
    background: var(--px-paper);
    border-block: 1px solid var(--px-line-soft);
  }

  .px-trust__list {
    max-inline-size: var(--page-content-width, 1200px);
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--px-space-4, 16px) var(--px-space-6, 32px);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .px-trust__item {
    display: flex;
    align-items: flex-start;
    gap: var(--px-space-3, 12px);
  }

  .px-trust__icon {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 14px;
    background: var(--px-white);
    color: var(--px-ink);
    box-shadow: var(--px-bevel), var(--px-shadow-1);
  }

  .px-trust__icon svg {
    inline-size: 24px;
    block-size: 24px;
  }

  .px-trust__text {
    display: grid;
    gap: 2px;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust strip",
  "tag": "div",
  "class": "px-trust-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Accessible label",
      "default": "Why shop with us"
    },
    {
      "type": "paragraph",
      "content": "Only add delivery, returns or warranty promises once they are confirmed."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "currency", "label": "Currency" },
            { "value": "lock", "label": "Lock" },
            { "value": "language", "label": "Language" },
            { "value": "shield", "label": "Shield" },
            { "value": "tile", "label": "Tile" }
          ],
          "default": "tile"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "currency", "title": "Prices in AED", "text": "Shown in UAE dirhams." } },
        { "type": "item", "settings": { "icon": "lock", "title": "Secure checkout", "text": "Encrypted Shopify checkout." } },
        { "type": "item", "settings": { "icon": "language", "title": "English and Arabic", "text": "Shop in the language you prefer." } },
        { "type": "item", "settings": { "icon": "shield", "title": "Safety information", "text": "Age and safety warnings on every product." } }
      ]
    }
  ]
}
{% endschema %}
