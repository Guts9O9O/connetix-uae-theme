{%- comment -%}
  Shop by range. One card per range collection. The name sits on the range colour at the
  top; the CONNETIX range photograph below starts on that same colour, so the child appears
  to stand in the card and the white tabletop becomes the card's floor.
  Without a photograph, the range's best pack sits on a white stage inside its colour.
  Mobile: a swipeable row. Desktop: a grid.
{%- endcomment -%}
<section class="px-worlds" aria-labelledby="PxWorldsTitle-{{ section.id }}">
  <div class="px-worlds__inner">
    <div class="px-head">
      <h2 class="px-head__title" id="PxWorldsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="px-head__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
    <ul class="px-worlds__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c != blank -%}
          {%- liquid
            assign photo = block.settings.image | default: c.image
            assign pack = blank
            if photo == blank
              for prod in c.products limit: 12
                if prod.metafields.custom.piece_count.value > 20 and prod.featured_image != blank
                  assign pack = prod.featured_image
                  break
                endif
              endfor
              if pack == blank
                assign pack = c.products.first.featured_image
              endif
            endif
            assign title = block.settings.title | default: c.title
          -%}
          <li
            class="px-world-card{% if photo != blank %} px-world-card--photo{% endif %}"
            data-range="{{ block.settings.range }}"
            {% if block.settings.room != blank %}
              style="--range-backdrop: {{ block.settings.room }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <a class="px-world-card__link" href="{{ c.url }}">
              <span class="px-world-card__body">
                <span class="px-world-card__name">{{ title | escape }}</span>
                {%- if block.settings.note != blank -%}
                  <span class="px-world-card__note">{{ block.settings.note | escape }}</span>
                {%- endif -%}
                <span class="px-world-card__count">{{ 'px.products_count' | t: count_text: c.products_count }}</span>
              </span>
              <span class="px-world-card__media">
                {%- if photo != blank -%}
                  {{
                    photo
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 540, 720, 900',
                      sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 80vw',
                      alt: '',
                      class: 'px-world-card__photo'
                  }}
                {%- elsif pack != blank -%}
                  <span class="px-world-card__stage">
                    {{
                      pack
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '300, 450, 600',
                        sizes: '(min-width: 990px) 22vw, 60vw',
                        alt: '',
                        class: 'px-world-card__pack'
                    }}
                  </span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .px-worlds {
    padding-block: clamp(48px, 7vw, 96px);
    padding-inline: var(--page-margin, 16px);
    background: var(--px-paper);
    color: var(--px-ink);
  }

  .px-worlds__inner {
    max-inline-size: var(--page-content-width, 1280px);
    margin-inline: auto;
  }

  .px-worlds__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78vw, 340px);
    gap: 12px;
    margin: 0;
    margin-inline: calc(-1 * var(--page-margin, 16px));
    padding: 0 var(--page-margin, 16px) 8px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-margin, 16px);
    scrollbar-width: thin;
  }

  @media screen and (min-width: 990px) {
    .px-worlds__grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: 16px;
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }
  }

  .px-world-card {
    scroll-snap-align: start;
    border-radius: var(--px-radius-panel, 24px);
    background: var(--range-backdrop);
    color: var(--range-ink);
    overflow: hidden;
    box-shadow: var(--px-bevel);
  }

  .px-world-card__link {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    color: inherit;
    text-decoration: none;
  }

  .px-world-card__media {
    position: relative;
    display: block;
    flex: 1 0 auto;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .px-world-card__photo {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    transition: transform var(--px-d-l, 560ms) var(--px-ease-standard);
  }

  .px-world-card__stage {
    position: absolute;
    inset: 0 12px 12px;
    border-radius: var(--px-radius-card, 16px);
    background: var(--px-white);
  }

  .px-world-card__pack {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 76%;
    block-size: 84%;
    margin: auto;
    object-fit: contain;
    transition: transform var(--px-d-l, 560ms) var(--px-ease-snap);
  }

  .px-world-card__body {
    display: grid;
    gap: 2px;
    padding: 20px 20px 14px;
  }

  .px-world-card__name {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .px-world-card__note {
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .px-world-card__count {
    font-size: 0.875rem;
    opacity: 0.8;
  }

  @media (hover: hover) {
    .px-world-card__link:hover .px-world-card__photo {
      transform: scale(1.04);
    }

    .px-world-card__link:hover .px-world-card__pack {
      transform: translateY(-4px) rotate(-2deg);
    }
  }

  .px-world-card__link:focus-visible {
    outline: var(--focus-outline-width, 3px) solid var(--px-ink);
    outline-offset: -5px;
    border-radius: var(--px-radius-panel, 24px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by range",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by range"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "range",
      "name": "Range",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Leave blank to use the collection title."
        },
        {
          "type": "text",
          "id": "note",
          "label": "Short note"
        },
        {
          "type": "select",
          "id": "range",
          "label": "Range colours",
          "options": [
            { "value": "rainbow", "label": "Rainbow" },
            { "value": "pastel", "label": "Pastel" },
            { "value": "bright", "label": "Bright" },
            { "value": "clear", "label": "Clear" },
            { "value": "glitter", "label": "Glitter" },
            { "value": "light", "label": "Light" },
            { "value": "roads", "label": "Roads and transport" },
            { "value": "pro", "label": "PRO" },
            { "value": "ball-run", "label": "Ball runs" }
          ],
          "default": "rainbow"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Optional. Defaults to the collection's own image."
        },
        {
          "type": "color",
          "id": "room",
          "label": "Backdrop colour",
          "info": "Optional. Match the photo's background."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by range"
    }
  ]
}
{% endschema %}
