{%- comment -%}
  "Light Table" hero: translucent tiles on a glowing table. Overlaps mix colours the way
  real translucent tiles do on a light box. Tiles drift in and snap together on load
  (CSS only); static under prefers-reduced-motion. Original artwork, mirrors in RTL.
{%- endcomment -%}
<section class="px-hero" aria-labelledby="PxHeroTitle-{{ section.id }}">
  <div class="px-hero__inner">
    <div class="px-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="px-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="px-hero__title" id="PxHeroTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="px-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="px-hero__actions">
        {%- if section.settings.button_1_label != blank -%}
          <a class="button px-hero__btn" href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_1_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="button button-secondary px-hero__btn" href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_2_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="px-hero__art" aria-hidden="true">
      <div class="px-hero__table"></div>
      <svg class="px-hero__tiles" viewBox="0 0 480 400" focusable="false">
        {%- comment -%} A small open structure: 4 squares, 4 triangles, 1 rhombus {%- endcomment -%}
        <g class="px-t" style="--i:0; --dx:-60px; --dy:-40px; --r:-14deg">
          <rect x="120" y="150" width="110" height="110" rx="10" fill="#E94B3C"/>
        </g>
        <g class="px-t" style="--i:1; --dx:40px; --dy:-60px; --r:10deg">
          <rect x="230" y="150" width="110" height="110" rx="10" fill="#2F80ED"/>
        </g>
        <g class="px-t" style="--i:2; --dx:-50px; --dy:50px; --r:8deg">
          <rect x="120" y="260" width="110" height="110" rx="10" fill="#F7D23E"/>
        </g>
        <g class="px-t" style="--i:3; --dx:60px; --dy:40px; --r:-10deg">
          <rect x="230" y="260" width="110" height="110" rx="10" fill="#5DBB63"/>
        </g>
        <g class="px-t" style="--i:4; --dx:-30px; --dy:-80px; --r:20deg">
          <path d="M120 150 L175 55 L230 150 Z" fill="#F39C33"/>
        </g>
        <g class="px-t" style="--i:5; --dx:30px; --dy:-90px; --r:-18deg">
          <path d="M230 150 L285 55 L340 150 Z" fill="#8E5BD9"/>
        </g>
        <g class="px-t" style="--i:6; --dx:80px; --dy:-20px; --r:24deg">
          <path d="M340 150 L430 205 L340 260 Z" fill="#01B0ED"/>
        </g>
        <g class="px-t" style="--i:7; --dx:-80px; --dy:10px; --r:-22deg">
          <path d="M120 260 L30 205 L120 150 Z" fill="#EC5253"/>
        </g>
        <g class="px-t" style="--i:8; --dx:20px; --dy:-110px; --r:30deg">
          <path d="M175 55 L230 0 L285 55 L230 110 Z" fill="#43BCCA"/>
        </g>
      </svg>
    </div>
  </div>
</section>

{% stylesheet %}
  .px-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 7vw, 96px);
    padding-inline: var(--page-margin, 16px);
    background:
      radial-gradient(120% 90% at 85% 40%, rgb(255 255 255 / 0.9), transparent 60%),
      linear-gradient(180deg, var(--px-paper), #e9ecf3);
    color: var(--px-ink);
  }

  [dir='rtl'] .px-hero {
    background:
      radial-gradient(120% 90% at 15% 40%, rgb(255 255 255 / 0.9), transparent 60%),
      linear-gradient(180deg, var(--px-paper), #e9ecf3);
  }

  .px-hero__inner {
    max-inline-size: var(--page-content-width, 1200px);
    margin-inline: auto;
    display: grid;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }

  @media screen and (min-width: 900px) {
    .px-hero__inner {
      grid-template-columns: 1fr 1.05fr;
    }
  }

  .px-hero__eyebrow {
    margin: 0 0 var(--px-space-3, 12px);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--px-plum);
  }

  .px-hero__title {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.02;
    color: inherit;
  }

  :lang(ar) .px-hero__title {
    line-height: 1.25;
  }

  .px-hero__text {
    max-inline-size: 46ch;
    margin-block-start: var(--px-space-4, 16px);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .px-hero__text > * {
    margin: 0;
  }

  .px-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--px-space-3, 12px);
    margin-block-start: var(--px-space-6, 32px);
  }

  .px-hero__art {
    position: relative;
    aspect-ratio: 6 / 5;
    max-inline-size: 560px;
    inline-size: 100%;
    justify-self: center;
  }

  .px-hero__table {
    position: absolute;
    inset: 12% 4% 2%;
    border-radius: 32px;
    background: radial-gradient(closest-side, #ffffff, #f4f7ff 70%, #e3e9f7);
    box-shadow:
      0 0 0 1px rgb(24 39 79 / 0.06),
      0 30px 60px -20px rgb(1 176 237 / 0.35),
      inset 0 2px 0 rgb(255 255 255 / 0.9);
    transform: perspective(900px) rotateX(18deg);
  }

  .px-hero__tiles {
    position: relative;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
  }

  [dir='rtl'] .px-hero__tiles {
    transform: scaleX(-1);
  }

  .px-t > * {
    fill-opacity: 0.72;
    mix-blend-mode: multiply;
    stroke: rgb(255 255 255 / 0.85);
    stroke-width: 4;
    paint-order: stroke;
  }

  @media (prefers-reduced-motion: no-preference) {
    .px-t {
      transform-box: fill-box;
      transform-origin: center;
      animation: px-snap-in var(--px-d-l, 560ms) var(--px-ease-snap) both;
      animation-delay: calc(240ms + var(--i) * 70ms);
    }
  }

  @keyframes px-snap-in {
    from {
      opacity: 0;
      transform: translate(var(--dx), var(--dy)) rotate(var(--r));
    }
    60% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Light table hero",
  "tag": "div",
  "class": "px-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Magnetic tiles"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build it in colour"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Translucent magnetic tiles that click together for open-ended play. Placeholder copy — replace with brand-approved text.</p>"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button label",
      "default": "Shop by range"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "Find a gift"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Light table hero"
    }
  ]
}
{% endschema %}
