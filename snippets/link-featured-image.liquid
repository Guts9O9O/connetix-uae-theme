{%- doc -%}
  Renders the featured image for a menu item.

  @param {object} link - The link to render
  @param {string} [class] - The class to apply to the image
  @param {string} [sizes] - The sizes to apply to the image

  @example
  {% render 'link-featured-image', link: link %}
{%- enddoc -%}

{% assign image_sizes = sizes | default: 'auto' %}

{%- capture link_image -%}
{% if link.type == 'collection_link' %}
  {% if link.object.featured_image %}
    {{
      link.object.featured_image
      | image_url: width: 800
      | image_tag: loading: 'lazy', class: class, sizes: image_sizes
    }}
  {% endif %}
{% elsif link.type == 'collections_link' %}
  {% assign collection_object = collections | where: 'featured_image' | first %}
  {% if collection_object.featured_image %}
    {{
      collection_object.featured_image
      | image_url: width: 800
      | image_tag: loading: 'lazy', class: class, sizes: image_sizes
    }}
  {% endif %}
{% elsif link.type == 'catalog_link' %}
  {% assign product_object = collections.all.products | where: 'featured_image' | first %}
  {% if product_object.featured_image %}
    {{
      product_object.featured_image
      | image_url: width: 800
      | image_tag: loading: 'lazy', class: class, sizes: image_sizes
    }}
  {% endif %}
{% elsif link.type == 'http_link' %}
  {% comment %} A typed /collections/<handle> URL still gets that collection's image. {% endcomment %}
  {% assign url_path = link.url | split: '?' | first %}
  {% if url_path contains '/collections/' %}
    {% assign url_handle = url_path | split: '/collections/' | last | split: '/' | first %}
    {% assign url_collection = collections[url_handle] %}
    {% if url_collection.featured_image %}
      {{
        url_collection.featured_image
        | image_url: width: 800
        | image_tag: loading: 'lazy', class: class, sizes: image_sizes
      }}
    {% endif %}
  {% endif %}
{% endif %}
{%- endcapture -%}

{%- if link_image != blank -%}
  {{ link_image }}
{%- else -%}
  {%- comment -%} No image for this link (a page, say): a branded tile keeps the grid even. {%- endcomment -%}
  <span class="{{ class }} px-link-fallback" aria-hidden="true"></span>
{%- endif -%}
