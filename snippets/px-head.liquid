{%- doc -%}
  CONNETIX UAE brand layer, rendered in <head> after Horizon's own variables.
  Loads the px token and base stylesheets and the cart "snap" script.
  The store is English-only (left-to-right), so no extra script fonts are loaded.
{%- enddoc -%}
{{ 'px-tokens.css' | asset_url | stylesheet_tag }}
{{ 'px-base.css' | asset_url | stylesheet_tag }}
<script src="{{ 'px-snap.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'px-motion.js' | asset_url }}" type="module" fetchpriority="low"></script>
