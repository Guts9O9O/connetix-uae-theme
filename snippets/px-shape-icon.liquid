{%- doc -%}
  Simple line-and-fill icon for a tile shape (used by "What's in the box").
  Original geometric drawings; colour comes from the range accent.

  @param {string} shape - shape slug from the box_contents metafield (e.g. 'square', 'ball')
{%- enddoc -%}
{%- liquid
  assign tone = 'accent'
  case shape
    when 'square', 'portal-square', 'light-tile', 'base-plate'
      assign d = 'M10 10H38V38H10Z'
    when 'large-square'
      assign d = 'M5 5H43V43H5Z'
    when 'equilateral-triangle'
      assign d = 'M24 8L41 38H7Z'
    when 'isosceles-triangle'
      assign d = 'M24 4L36 40H12Z'
    when 'right-triangle'
      assign d = 'M10 8V40H40Z'
    when 'rhombus'
      assign d = 'M24 5L39 24L24 43L9 24Z'
    when 'rectangle', 'door'
      assign d = 'M6 16H42V32H6Z'
    when 'window'
      assign d = 'M8 12H40V36H8Z'
    when 'tube'
      assign d = 'M6 18H42V30H6Z'
    when 'vehicle-base'
      assign d = 'M6 18H42V32H6Z'
    when 'road-straight', 'road-curve', 'road-junction'
      assign d = 'M6 6H42V42H6Z'
      assign tone = 'ink'
    else
      assign d = 'M10 10H38V38H10Z'
  endcase
-%}
<svg class="px-shape px-shape--{{ tone }}" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  {%- if shape == 'ball' -%}
    <circle class="px-shape__body" cx="24" cy="24" r="14"/>
    <circle cx="19" cy="19" r="4" fill="#fff" fill-opacity=".55"/>
  {%- else -%}
    <path class="px-shape__body" d="{{ d }}" stroke-width="2" stroke-linejoin="round"/>
    <path d="{{ d }}" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width="2" stroke-linejoin="round" transform="translate(24 24) scale(.72) translate(-24 -24)"/>
    {%- case shape -%}
      {%- when 'portal-square' -%}
        <path d="M17 17H31V31H17Z" class="px-shape__hole" stroke-width="1.5"/>
      {%- when 'window' -%}
        <path d="M14 18H34V30H14Z" fill="#fff" fill-opacity=".7"/>
      {%- when 'door' -%}
        <path d="M30 20V28" class="px-shape__ink-line" stroke-width="2" stroke-linecap="round"/>
      {%- when 'light-tile' -%}
        <circle cx="24" cy="24" r="6" fill="#ffd84d" class="px-shape__ink-stroke" stroke-width="1.5"/>
      {%- when 'tube' -%}
        <path d="M6 24H42" stroke="#fff" stroke-opacity=".8" stroke-width="3"/>
      {%- when 'vehicle-base' -%}
        <circle cx="14" cy="36" r="4" class="px-shape__ink"/><circle cx="34" cy="36" r="4" class="px-shape__ink"/>
      {%- when 'road-straight' -%}
        <path d="M10 24H16M21 24H27M32 24H38" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/>
      {%- when 'road-curve' -%}
        <path d="M6 24A18 18 0 0 1 24 42" fill="none" stroke="#fff" stroke-width="2.5" stroke-dasharray="5 5"/>
      {%- when 'road-junction' -%}
        <path d="M6 24H42M24 6V42" stroke="#fff" stroke-width="2.5" stroke-dasharray="5 5"/>
    {%- endcase -%}
  {%- endif -%}
</svg>
