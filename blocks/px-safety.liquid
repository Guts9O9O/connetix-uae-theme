{%- doc -%}
  Safety and care panel, always visible on product pages. Wording follows the official
  CONNETIX global website (age guidance, care) and the TRUCARE FZC brief: no invented
  warnings and no certification claims. If the exact packaging warning text for a SKU is
  entered in the product metafield custom.manufacturer_warnings, it is shown first, verbatim.
{%- enddoc -%}
{%- assign p = closest.product -%}
{%- assign packaging = p.metafields.custom.manufacturer_warnings -%}
{%- if p != blank -%}
  <section class="px-safety" aria-labelledby="PxSafetyTitle-{{ block.id }}" {{ block.shopify_attributes }}>
    <div class="px-safety__head">
      <svg class="px-safety__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 3 22 20H2Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        <path d="M12 10v4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <circle cx="12" cy="17.2" r="1.2" fill="currentColor"/>
      </svg>
      <h2 class="px-safety__title" id="PxSafetyTitle-{{ block.id }}">{{ 'px.safety_title' | t }}</h2>
    </div>
    <div class="px-safety__body">
      {%- if packaging != blank -%}
        <p class="px-safety__packaging">{{ packaging.value | escape | newline_to_br }}</p>
      {%- endif -%}
      <p>{{ 'px.safety_age' | t }}</p>
      <p>{{ 'px.safety_follow' | t }}</p>
      <p>{{ 'px.safety_care' | t }}</p>
      <p><a href="/pages/product-safety">{{ 'px.safety_more' | t }}</a></p>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .px-safety {
    padding: var(--px-space-4, 16px) var(--px-space-5, 24px);
    border-radius: var(--px-radius-card, 16px);
    border-inline-start: 4px solid var(--px-coral);
    background: var(--px-white);
    color: var(--px-ink);
  }

  .px-safety__head {
    display: flex;
    align-items: center;
    gap: var(--px-space-2, 8px);
    margin-block-end: var(--px-space-2, 8px);
  }

  .px-safety__icon {
    inline-size: 22px;
    block-size: 22px;
    flex: none;
    color: var(--px-ink);
  }

  .px-safety__title {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--px-ink);
  }

  .px-safety__body {
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .px-safety__body p {
    margin: 0;
  }

  .px-safety__body p + p {
    margin-block-start: 0.5em;
  }

  .px-safety__packaging {
    font-weight: 600;
  }

  .px-safety__body a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Safety and care",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows CONNETIX age and care guidance, plus the exact packaging warning text from the product metafield custom.manufacturer_warnings when it is filled in."
    }
  ],
  "presets": [
    {
      "name": "Safety and care"
    }
  ]
}
{% endschema %}
