{%- doc -%}
  Language switch for the footer: one button per published language, labelled in its own
  language (English / العربية). Works without JavaScript (native localization form).
  Renders nothing when the store has a single language.
{%- enddoc -%}
{%- if localization.available_languages.size > 1 -%}
  <div class="px-lang" {{ block.shopify_attributes }}>
    {%- form 'localization', id: 'PxLangForm', class: 'px-lang__form', return_to: request.path -%}
      <span class="px-lang__label" id="PxLangLabel-{{ block.id }}">{{ 'px.language' | t }}</span>
      <div class="px-lang__options" role="group" aria-labelledby="PxLangLabel-{{ block.id }}">
        {%- for language in localization.available_languages -%}
          {%- if language.iso_code == localization.language.iso_code -%}
            <span class="px-lang__option" lang="{{ language.iso_code }}" aria-current="true">
              {{- language.endonym_name | capitalize -}}
            </span>
          {%- else -%}
            <button
              type="submit"
              class="px-lang__option"
              name="locale_code"
              value="{{ language.iso_code }}"
              lang="{{ language.iso_code }}"
            >
              {{- language.endonym_name | capitalize -}}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endform -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .px-lang__form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--px-space-3, 12px);
  }

  .px-lang__label {
    font-size: 0.875rem;
    opacity: 0.8;
  }

  .px-lang__options {
    display: inline-flex;
    gap: var(--px-space-1, 4px);
    padding: var(--px-space-1, 4px);
    border-radius: var(--px-radius-pill, 999px);
    background: rgb(var(--color-foreground-rgb) / 0.08);
  }

  .px-lang__option {
    min-block-size: 36px;
    min-inline-size: 44px;
    padding-block: 6px;
    padding-inline: var(--px-space-4, 16px);
    border: 0;
    border-radius: var(--px-radius-pill, 999px);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .px-lang__option[aria-current='true'] {
    background: var(--color-foreground);
    color: var(--color-background);
    cursor: default;
  }

  .px-lang__option:not([aria-current]):hover {
    background: rgb(var(--color-foreground-rgb) / 0.12);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Language switch",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows a button for each published language. Add languages in Settings > Languages."
    }
  ],
  "presets": [
    {
      "name": "Language switch"
    }
  ]
}
{% endschema %}
