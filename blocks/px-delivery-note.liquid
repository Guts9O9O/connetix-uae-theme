{%- doc -%}
  Delivery note under the buy buttons. Text comes from the block settings (TRUCARE FZC
  brief: free delivery across the GCC; usually 1–3 days in the UAE and 5–7 days elsewhere
  in the GCC, shown as estimates). The courier is never named.
{%- enddoc -%}
<div class="px-deliv" {{ block.shopify_attributes }}>
  <svg class="px-deliv__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M3 6h11v10H3zM14 9h4l3 3v4h-7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    <circle cx="7" cy="17.5" r="1.8" fill="var(--px-white)" stroke="currentColor" stroke-width="1.8"/>
    <circle cx="17" cy="17.5" r="1.8" fill="var(--px-white)" stroke="currentColor" stroke-width="1.8"/>
  </svg>
  <div class="px-deliv__copy">
    {%- if block.settings.title != blank -%}
      <p class="px-deliv__title">{{ block.settings.title | escape }}</p>
    {%- endif -%}
    {%- if block.settings.text != blank -%}
      <p class="px-deliv__text">{{ block.settings.text | escape }}</p>
    {%- endif -%}
    {%- if block.settings.link_label != blank and block.settings.link != blank -%}
      <a class="px-deliv__link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .px-deliv {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    padding: 14px 16px;
    border-radius: var(--px-radius-card, 16px);
    background: var(--px-mist);
    color: var(--px-ink);
  }

  .px-deliv__icon {
    inline-size: 24px;
    block-size: 24px;
    margin-block-start: 1px;
  }

  .px-deliv__title {
    margin: 0;
    font-weight: 700;
    line-height: 1.35;
  }

  .px-deliv__text {
    margin: 4px 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--px-ink-soft);
  }

  .px-deliv__link {
    display: inline-block;
    margin-block-start: 6px;
    font-size: 0.9375rem;
    color: var(--px-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Delivery note",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Free delivery across the GCC"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Usually 1–3 days within the UAE and 5–7 days to Saudi Arabia, Kuwait, Qatar, Bahrain and Oman. These are estimates, not guaranteed delivery dates."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shipping policy"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Delivery note"
    }
  ]
}
{% endschema %}
