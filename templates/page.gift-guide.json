/*
 * CONNETIX UAE — gift guide page template (px layer).
 * Assign to the 'Gift guide' page in Online Store > Pages.
 */
{
  "sections": {
    "main": {
      "type": "main-page",
      "blocks": {
        "heading": {
          "type": "text",
          "name": "t:names.title",
          "settings": {
            "text": "<h1>{{ closest.page.title }}</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h2",
            "font": "var(--font-body--family)",
            "font_size": "",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "page-content": {
          "type": "page-content",
          "settings": {},
          "blocks": {}
        }
      },
      "block_order": [
        "heading",
        "page-content"
      ],
      "settings": {
        "content_direction": "column",
        "gap": 32,
        "padding-block-start": 40,
        "padding-block-end": 80
      }
    },
    "px_paths": {
      "type": "px-pack-finder",
      "settings": {
        "heading": "Find the right gift",
        "text": "Pick a budget or a kind of build. Every set connects with every other."
      },
      "blocks": {
        "g1": {
          "type": "path",
          "settings": {
            "label": "Under AED 300",
            "hint": "Gift-ready packs at a smaller budget.",
            "cta": "Shop gifts under AED 300",
            "collection": "gifts-under-300",
            "shape": "rhombus",
            "range": "glitter"
          }
        },
        "g2": {
          "type": "path",
          "settings": {
            "label": "A first set",
            "hint": "For a child new to magnetic tiles.",
            "cta": "Shop starter sets",
            "collection": "starter-sets",
            "shape": "square",
            "range": "pastel"
          }
        },
        "g3": {
          "type": "path",
          "settings": {
            "label": "A big build",
            "hint": "100+ pieces for towers and whole cities.",
            "cta": "Shop large sets",
            "collection": "large-sets",
            "shape": "large-square",
            "range": "bright"
          }
        },
        "g4": {
          "type": "path",
          "settings": {
            "label": "Something that glows",
            "hint": "Light-up tiles for night-time builds.",
            "cta": "Shop light-up sets",
            "collection": "light",
            "shape": "portal-square",
            "range": "clear"
          }
        }
      },
      "block_order": [
        "g1",
        "g2",
        "g3",
        "g4"
      ]
    },
    "list_under_300": {
      "type": "product-list",
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "name": "t:names.header",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "space-between",
