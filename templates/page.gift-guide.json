                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "px_meta": {
              "type": "px-product-meta",
              "settings": {
                "size": "small",
                "show_subtitle": false,
                "show_range": true,
                "show_pieces": true,
                "show_age": false
              },
              "blocks": {}
            }
          },
          "block_order": [
            "product_card_gallery_677WP3",
            "product_title_YXxMTj",
            "px_meta",
            "price_JQzVV4"
          ]
        }
